{
  "name": "tally-xml-tdl",
  "version": "1.6.1",
  "description": "Simple, clean TDL and XML extraction and manipulation tools for Tally",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./v6": {
      "types": "./src/v6/index.d.ts",
      "import": "./src/v6/index.js",
      "default": "./src/v6/index.js"
    }
  },
  "files": [
    "src/v6",
    "src/index.js",
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://keshavsoft.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/keshavsoft/tally-xml-tdl"
  },
  "bugs": {
    "url": "https://github.com/keshavsoft/tally-xml-tdl/issues"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "stream-chain": "^4.2.5",
    "stream-json": "^3.6.0"
  }
}