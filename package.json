  "files": [
    "src",
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://keshavsoft.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/keshavsoft/tally-xml-tdl"
  },
  "bugs": {
    "url": "https://github.com/keshavsoft/tally-xml-tdl/issues"
  },
  "scripts": {
    "generate:dts": "create-intellisense",
    "test": "node --test Test/v27/company.js Test/v27/index.js Test/v27/units.js"
  },
  "devDependencies": {
    "create-intellisense": "^1.2.1"
  },
  "dependencies": {
    "@keshavsoft/api-tree": "^11.1.1",
    "tally-spec": "^1.2.2"
  }
}