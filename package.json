{
  "name": "tally-xml-tdl",
  "version": "1.1.1",
  "description": "Simple, clean TDL and XML extraction and manipulation tools for Tally",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./v1": {
      "types": "./src/v1/index.d.ts",
      "import": "./src/v1/index.js",
      "default": "./src/v1/index.js"
    },
    "./v2": {
      "types": "./src/v2/index.d.ts",
      "import": "./src/v2/index.js",
      "default": "./src/v2/index.js"
    },
    "./v3": {
      "types": "./src/v3/index.d.ts",
      "import": "./src/v3/index.js",
      "default": "./src/v3/index.js"
    },
    "./*": "./src/*.js"
  },
  "files": [
    "src",
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://keshavsoft.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/keshavsoft/tally-xml-tdl"
  },
  "bugs": {
    "url": "https://github.com/keshavsoft/tally-xml-tdl/issues"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "stream-chain": "^4.2.5",
    "stream-json": "^3.6.0"
  }
}