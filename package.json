{
  "name": "tally-xml-tdl",
  "version": "1.27.3",
  "description": "Simple, clean TDL and XML extraction and manipulation tools for Tally",
  "type": "module",
  "main": "src/index.js",
  "module": "./src/index.js",
  "types": "index.d.ts",
